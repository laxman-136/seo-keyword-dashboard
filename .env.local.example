# ============================================
# PRODUCTION DEPLOYMENT
# ============================================
# Get these credentials from https://supabase.com
# After creating a project, go to: Settings → API

# Your Supabase project URL
# From: Settings → API → Project URL
SUPABASE_URL=https://your-project.supabase.co

# Public anon key (safe to expose in frontend)
# From: Settings → API → Anon public key
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key (KEEP SECRET - only in server env vars)
# From: Settings → API → Service role secret
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT Secret for session tokens
# Generate a strong random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-strong-random-jwt-secret-here

# ============================================
# OPTIONAL SETTINGS
# ============================================

# Google Sheets API Key (optional - for data import)
# Get from: https://console.cloud.google.com
GOOGLE_SHEETS_API_KEY=your_google_sheets_api_key_here

# Legacy password gate (optional)
# Leave blank to disable
NEXT_PUBLIC_DASHBOARD_PASSWORD=

